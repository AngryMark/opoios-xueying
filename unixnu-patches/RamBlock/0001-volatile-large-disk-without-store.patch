--- a/NativeRamBlock.cpp
+++ b/NativeRamBlock.cpp
@@ -198,6 +198,26 @@ class NativeRamBlock : public IOBlockStorageDevice {
   };
   IOReturn directReadWrite(IOMemoryDescriptor *buffer, uint64_t offset, uint64_t bytes, uint64_t *actual, uint64_t *waited);
   void persistFailed() { overlay.active = false; native_data_persist_state = 5; __atomic_fetch_add(&native_data_persist_errors, 1, __ATOMIC_RELAXED); }
+  // Gate held. A disk above 2 GiB without a store had no write path: every write was answered NotReady for the whole boot. It becomes the
+  // volatile sparse disk a disk up to 2 GiB is: its seed pages move into a page table (8 bytes per 4 KiB page, 8 MiB for 4 GiB) and every
+  // write stays in RAM. The seed identity (seedHash) was taken at start and does not change. Without memory it stays as it was.
+  void makeVolatile() {
+    const uint64_t pages = big.bytes / 4096;
+    uint8_t **table = static_cast<uint8_t **>(IOMallocZero(pages * sizeof(uint8_t *)));
